  "license": "MIT",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development webpack serve --config node_modules/flareact/configs/webpack.client.config.js --mode development",
    "build:worker": "NODE_ENV=production webpack --config node_modules/flareact/webpack.js --mode production",
    "build": "yarn css && yarn build:client && yarn build:worker",
    "deploy": "yarn build && wrangler deploy",
    "kv-gc": "node ./src/cli/gcMonitors.js",
    "format": "prettier --write '**/*.{js,css,json,md}'",
    "css": "postcss public/tailwind.css -o public/style.css",
    "build:client": "NODE_ENV=production webpack --config node_modules/flareact/configs/webpack.client.config.js --mode production",
    "test:security": "node scripts/test-modern-build.cjs"
  },
  "dependencies": {
    "flareact": "file:vendor/flareact",
    "laco": "^1.2.1",
    "laco-react": "^1.1.0",
    "react": "^17.0.1",
    "react-dom": "^17.0.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.0.2",
    "node-fetch": "^2.6.1",
    "postcss": "^8.5.23",
    "postcss-cli": "^8.3.0",
    "prettier": "^2.2.0",
    "tailwindcss": "^2.0.1",
    "yaml-loader": "^0.6.0",
    "webpack": "5.112.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.6",
    "webpack-dev-middleware": "7.4.6",
    "mini-css-extract-plugin": "2.9.4",
    "css-minimizer-webpack-plugin": "7.0.4",
    "terser-webpack-plugin": "5.6.1",
