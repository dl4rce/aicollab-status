    "lodash": "^4.18.0",
    "ws": "^6.2.4",
    "glob-parent": "^5.1.2",
    "webpack-dev-server": "^5.2.5",
    "webpack-dev-middleware": "^5.3.4",
    "http-proxy-middleware": "^2.0.10"
