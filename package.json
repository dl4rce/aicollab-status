    "node-fetch": "^2.6.1",
    "postcss": "^8.2.13",
    "postcss-cli": "^8.3.0",
    "prettier": "^2.2.0",
    "tailwindcss": "^2.0.1",
    "yaml-loader": "^0.6.0"
  },
  "resolutions": {
    "websocket-driver": "^0.7.5",
    "node-forge": "^1.3.1",
    "nth-check": "^2.0.1",
